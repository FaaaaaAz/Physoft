# ============================================
# Environment Variables - Physoft Backend
# ============================================

# Server port
PORT=3000

# Database URL
# Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL - example):
# DATABASE_URL="postgresql://user:password@localhost:5432/physoft?schema=public"

# Runtime environment
NODE_ENV=development

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Provider Configuration
# Valores permitidos: gemini | openai
AI_PROVIDER=gemini

# Gemini (required if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (required if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=60000

# JWT Secret (for future implementation)
# JWT_SECRET=your-super-secure-secret-key-here
